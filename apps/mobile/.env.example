# API URL for backend connection
# Leave unset to auto-detect from Expo dev server (recommended for development)
# Set explicitly for production builds or custom networking setups
# EXPO_PUBLIC_API_URL=http://YOUR_IP:3001/api/v1

# Examples:
# Local development (auto-detected via Expo):   leave empty
# Specific device/network:                      EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/api/v1
# Production:                                   EXPO_PUBLIC_API_URL=https://api.mucprosuit.com/api/v1
