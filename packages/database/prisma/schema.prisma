generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RoleCode {
  SUPER_ADMIN
  MASTER_ADMIN
  DOMAIN_ADMIN
  FACULTY
  STUDENT
}

enum DomainCode {
  ACADEMIC
  ATTENDANCE
  FINANCE
  LIBRARY
  PLACEMENT
  CERTIFICATE
  EVENT
  EXAMINATION
  NOTIFICATION
}

enum DomainAssignmentState {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TermType {
  ODD
  EVEN
}

enum ShiftCode {
  SHIFT_I
  SHIFT_II
}

enum FundingType {
  AIDED
  SELF_FINANCING
}

enum PeriodCode {
  H1
  H2
  H3
  H4
  H5
}

enum ProgramDegree {
  UG
  PG
}

enum GenderEligibility {
  ALL
  FEMALE_ONLY
}

enum SubjectType {
  CORE
  ELECTIVE
  LAB
  PROJECT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  DISCONTINUED
  TRANSFERRED
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
  SEPARATED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DISCONTINUED
  TRANSFERRED
  WITHDRAWN
}

enum AssignmentStatus {
  ACTIVE
  ENDED
  REVOKED
}

enum LeadershipRole {
  HOD
}

enum AuthClientType {
  WEB
  MOBILE
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  TOKEN_REUSE
  PASSWORD_RESET
  ACCOUNT_DISABLED
  ADMIN_REVOKED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

enum ProfileUpdateRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BackupStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id                 String        @id @default(uuid()) @db.Uuid
  username           String?
  normalizedUsername String?       @unique @map("normalized_username")
  email              String?
  normalizedEmail    String?       @unique @map("normalized_email")
  passwordHash       String        @map("password_hash")
  status             AccountStatus @default(PENDING)
  failedLoginCount   Int           @default(0) @map("failed_login_count")
  lockedUntil        DateTime?     @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?     @map("last_login_at") @db.Timestamptz(6)
  tokenVersion       Int           @default(0) @map("token_version")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student                  Student?                @relation("StudentUser")
  faculty                  Faculty?                @relation("FacultyUser")
  roleAssignments          UserRoleAssignment[]    @relation("UserRoleAssignments")
  domainAssignments        DomainAssignment[]      @relation("DomainAssignmentAssignee")
  grantedDomainAssignments DomainAssignment[]      @relation("DomainAssignmentGrantor")
  auditLogs                AuditLog[]              @relation("AuditActor")
  idempotencyKeys          IdempotencyKey[]        @relation("IdempotencyActor")
  backupRecords            BackupRecord[]          @relation("BackupCreator")
  authSessions             AuthSession[]
  passwordResetTokens      PasswordResetToken[]
  sessionsMarked           AttendanceSession[]     @relation("SessionMarkedBy")
  sessionsSubmitted        AttendanceSession[]     @relation("SessionSubmittedBy")
  sessionsLocked           AttendanceSession[]     @relation("SessionLockedBy")
  attendanceCorrections    AttendanceCorrection[]  @relation("AttendanceCorrectedBy")
  resultsEntered           ResultEntry[]           @relation("ResultEnteredBy")
  resultsRevised           ResultRevision[]        @relation("ResultRevisedBy")
  resultsPublished         ResultPublication[]     @relation("ResultPublishedBy")
  scholarshipsApproved     ScholarshipConcession[] @relation("ScholarshipApprovedBy")
  financialAdjustments     FinancialAdjustment[]   @relation("AdjustmentAdjustedBy")
  receiptsIssued           Receipt[]               @relation("ReceiptIssuedBy")
  libraryMember            LibraryMember?
  eventRegistrations       EventRegistration[]
  eventAttendances         EventAttendance[]
  notificationDeliveries   NotificationDelivery[]
  profileUpdateRequests    ProfileUpdateRequest[]

  @@index([status])
  @@map("users")
}

model AppVersion {
  id                 String       @id @default(uuid()) @db.Uuid
  platform           String       // "IOS", "ANDROID", "WEB"
  version            String       // "1.0.0"
  buildNumber        Int          @map("build_number")
  isMandatory        Boolean      @default(false) @map("is_mandatory")
  releaseNotes       String?      @map("release_notes")
  minRequiredVersion String?      @map("min_required_version")
  status             RecordStatus @default(ACTIVE)
  releaseDate        DateTime     @default(now()) @map("release_date") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([platform, status])
  @@map("app_versions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique
  domain      DomainCode?
  resource    String
  action      String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  roleId     String           @map("role_id") @db.Uuid
  assignedBy String?          @map("assigned_by") @db.Uuid
  startsAt   DateTime         @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime?        @map("ends_at") @db.Timestamptz(6)
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, startsAt])
  @@index([userId, status, endsAt])
  @@map("user_role_assignments")
}

model DomainAssignment {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  domain            DomainCode
  scopeDepartmentId String?               @map("scope_department_id") @db.Uuid
  scopeProgramId    String?               @map("scope_program_id") @db.Uuid
  effectiveStart    DateTime              @default(now()) @map("effective_start") @db.Timestamptz(6)
  effectiveEnd      DateTime?             @map("effective_end") @db.Timestamptz(6)
  state             DomainAssignmentState @default(ACTIVE)
  assignedById      String?               @map("assigned_by_id") @db.Uuid
  revokedAt         DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?               @map("revoked_reason")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User        @relation("DomainAssignmentAssignee", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy      User?       @relation("DomainAssignmentGrantor", fields: [assignedById], references: [id], onDelete: Restrict)
  scopeDepartment Department? @relation(fields: [scopeDepartmentId], references: [id], onDelete: Restrict)
  scopeProgram    Program?    @relation(fields: [scopeProgramId], references: [id], onDelete: Restrict)

  @@unique([userId, domain, scopeDepartmentId, scopeProgramId, effectiveStart])
  @@index([userId, domain, state, effectiveEnd])
  @@map("domain_assignments")
}

model AuthSession {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  familyId         String                   @default(uuid()) @map("family_id") @db.Uuid
  parentSessionId  String?                  @unique @map("parent_session_id") @db.Uuid
  refreshTokenHash String                   @unique @map("refresh_token_hash")
  clientType       AuthClientType           @map("client_type")
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?                @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedReason    SessionRevocationReason? @map("revoked_reason")
  ipAddress        String?                  @map("ip_address")
  userAgent        String?                  @map("user_agent")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  parentSession  AuthSession? @relation("SessionRotation", fields: [parentSessionId], references: [id], onDelete: Restrict)
  rotatedSession AuthSession? @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@index([familyId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  requestIp String?   @map("request_ip")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  actorId       String?      @map("actor_id") @db.Uuid
  action        String
  resourceType  String       @map("resource_type")
  resourceId    String?      @map("resource_id")
  requestId     String?      @map("request_id")
  correlationId String?      @map("correlation_id")
  outcome       AuditOutcome
  beforeState   Json?        @map("before_state") @db.JsonB
  afterState    Json?        @map("after_state") @db.JsonB
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  actorId      String?           @map("actor_id") @db.Uuid
  subjectKey   String            @map("subject_key")
  key          String
  operation    String
  requestHash  String?           @map("request_hash")
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body") @db.JsonB
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  actor User? @relation("IdempotencyActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([subjectKey, key, operation])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(6)
  lastError     String?      @map("last_error")
  requestId     String?      @map("request_id")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model BackupRecord {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  providerKey String?      @map("provider_key")
  checksum    String?
  status      BackupStatus @default(REQUESTED)
  sizeBytes   BigInt?      @map("size_bytes")
  createdById String?      @map("created_by_id") @db.Uuid
  startedAt   DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  createdBy User? @relation("BackupCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("backup_records")
}

model AcademicYear {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  isActive  Boolean      @default(false) @map("is_active")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  terms       AcademicTerm[]
  classes     AcademicClass[]
  enrollments StudentEnrollment[]

  feeStructures FeeStructure[]

  @@map("academic_years")
}

model AcademicTerm {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  type           TermType
  termNumber     Int          @map("term_number")
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  isActive       Boolean      @default(false) @map("is_active")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  enrollments         StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  timetableVersions   TimetableVersion[]
  attendanceSessions  AttendanceSession[]
  assessments         Assessment[]

  @@unique([academicYearId, type])
  @@unique([academicYearId, termNumber])
  @@index([academicYearId, isActive])
  @@map("academic_terms")
}

model Shift {
  id          String      @id @default(uuid()) @db.Uuid
  code        ShiftCode   @unique
  name        String
  fundingType FundingType @map("funding_type")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  periodDefinitions PeriodDefinition[]
  programs          Program[]

  feeStructures FeeStructure[]

  @@map("shifts")
}

model PeriodDefinition {
  id        String     @id @default(uuid()) @db.Uuid
  shiftId   String     @map("shift_id") @db.Uuid
  code      PeriodCode
  sortOrder Int        @map("sort_order")
  startTime DateTime   @map("start_time") @db.Time(0)
  endTime   DateTime   @map("end_time") @db.Time(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  shift              Shift               @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]

  @@unique([shiftId, code])
  @@unique([shiftId, sortOrder])
  @@map("period_definitions")
}

model Department {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  programs              Program[]
  faculty               Faculty[]
  admissionStudents     Student[]                        @relation("StudentAdmissionDepartment")
  enrollmentHistory     StudentEnrollment[]              @relation("EnrollmentDepartment")
  domainAssignments     DomainAssignment[]
  leadershipAssignments DepartmentLeadershipAssignment[]

  driveEligibilities DriveDepartmentEligibility[]

  @@map("departments")
}

model Program {
  id                String            @id @default(uuid()) @db.Uuid
  departmentId      String            @map("department_id") @db.Uuid
  shiftId           String            @map("shift_id") @db.Uuid
  code              String            @unique
  name              String
  degree            ProgramDegree
  durationYears     Int               @map("duration_years")
  totalSemesters    Int               @map("total_semesters")
  fundingType       FundingType       @map("funding_type")
  genderEligibility GenderEligibility @default(ALL) @map("gender_eligibility")
  regulation        String?
  status            RecordStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  department         Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  shift              Shift                    @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  curriculumVersions CurriculumVersion[]
  academicClasses    AcademicClass[]
  admissionStudents  Student[]                @relation("StudentAdmissionProgram")
  enrollmentHistory  StudentEnrollment[]      @relation("EnrollmentProgram")
  domainAssignments  DomainAssignment[]
  feeStructures      FeeStructure[]
  driveEligibilities DriveCourseEligibility[]

  @@index([departmentId, status])
  @@index([shiftId, fundingType])
  @@map("programs")
}

model CurriculumVersion {
  id            String       @id @default(uuid()) @db.Uuid
  programId     String       @map("program_id") @db.Uuid
  code          String
  regulation    String?
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  program           Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  programSubjects   ProgramSubject[]
  enrollmentHistory StudentEnrollment[] @relation("EnrollmentCurriculum")

  @@unique([programId, code])
  @@index([programId, status])
  @@map("curriculum_versions")
}

model ProgramSubject {
  id                  String       @id @default(uuid()) @db.Uuid
  curriculumVersionId String       @map("curriculum_version_id") @db.Uuid
  code                String
  name                String
  semesterNumber      Int          @map("semester_number")
  credits             Decimal      @db.Decimal(5, 2)
  type                SubjectType
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  curriculumVersion   CurriculumVersion    @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  attendanceSessions  AttendanceSession[]
  assessments         Assessment[]

  @@unique([curriculumVersionId, code])
  @@index([curriculumVersionId, semesterNumber, status])
  @@map("program_subjects")
}

model AcademicClass {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  programId      String       @map("program_id") @db.Uuid
  yearOfStudy    Int          @map("year_of_study")
  code           String
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  program             Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  enrollments         StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  advisories          ClassAdvisory[]
  timetableVersions   TimetableVersion[]
  attendanceSessions  AttendanceSession[]
  assessments         Assessment[]

  @@unique([academicYearId, programId, yearOfStudy])
  @@unique([academicYearId, code])
  @@index([programId, academicYearId, status])
  @@map("academic_classes")
}

model Room {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  roomType  String?      @map("room_type")
  capacity  Int?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  timetableSlots TimetableSlot[]

  @@map("rooms")
}

model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String?       @unique @map("user_id") @db.Uuid
  registrationNumber    String        @unique @map("registration_number")
  admissionNumber       String        @unique @map("admission_number")
  firstName             String        @map("first_name")
  lastName              String        @map("last_name")
  email                 String?
  normalizedEmail       String?       @unique @map("normalized_email")
  phone                 String?
  dateOfBirth           DateTime?     @map("date_of_birth") @db.Date
  gender                String?
  bloodGroup            String?       @map("blood_group")
  guardianName          String?       @map("guardian_name")
  guardianPhone         String?       @map("guardian_phone")
  admissionDepartmentId String        @map("admission_department_id") @db.Uuid
  admissionProgramId    String        @map("admission_program_id") @db.Uuid
  admissionDate         DateTime?     @map("admission_date") @db.Date
  status                StudentStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User?               @relation("StudentUser", fields: [userId], references: [id], onDelete: Restrict)
  admissionDepartment Department          @relation("StudentAdmissionDepartment", fields: [admissionDepartmentId], references: [id], onDelete: Restrict)
  admissionProgram    Program             @relation("StudentAdmissionProgram", fields: [admissionProgramId], references: [id], onDelete: Restrict)
  enrollments         StudentEnrollment[]

  @@index([admissionDepartmentId, status])
  @@index([admissionProgramId, status])
  @@map("students")
}

model Faculty {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String?       @unique @map("user_id") @db.Uuid
  employeeId      String        @unique @map("employee_id")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  email           String?
  normalizedEmail String?       @unique @map("normalized_email")
  phone           String?
  departmentId    String        @map("department_id") @db.Uuid
  designation     String
  specialization  String?
  status          FacultyStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                  User?                            @relation("FacultyUser", fields: [userId], references: [id], onDelete: Restrict)
  department            Department                       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  teachingAssignments   TeachingAssignment[]
  classAdvisories       ClassAdvisory[]
  leadershipAssignments DepartmentLeadershipAssignment[]

  @@index([departmentId, status])
  @@map("faculty")
}

model StudentEnrollment {
  id                  String           @id @default(uuid()) @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  academicYearId      String           @map("academic_year_id") @db.Uuid
  academicTermId      String           @map("academic_term_id") @db.Uuid
  academicClassId     String           @map("academic_class_id") @db.Uuid
  programId           String           @map("program_id") @db.Uuid
  departmentId        String           @map("department_id") @db.Uuid
  curriculumVersionId String           @map("curriculum_version_id") @db.Uuid
  semesterNumber      Int              @map("semester_number")
  yearOfStudy         Int              @map("year_of_study")
  shiftSnapshot       ShiftCode        @map("shift_snapshot")
  status              EnrollmentStatus @default(ACTIVE)
  effectiveFrom       DateTime         @map("effective_from") @db.Date
  effectiveTo         DateTime?        @map("effective_to") @db.Date
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  student               Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  academicTerm          AcademicTerm           @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  academicClass         AcademicClass          @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  program               Program                @relation("EnrollmentProgram", fields: [programId], references: [id], onDelete: Restrict)
  department            Department             @relation("EnrollmentDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  curriculumVersion     CurriculumVersion      @relation("EnrollmentCurriculum", fields: [curriculumVersionId], references: [id], onDelete: Restrict)
  attendanceEntries     AttendanceEntry[]
  resultEntries         ResultEntry[]
  financialAccount      FinancialAccount?
  placementRegistration PlacementRegistration?
  placementApplications PlacementApplication[]
  certificateRequests   CertificateRequest[]

  @@unique([studentId, academicTermId])
  @@index([studentId, effectiveFrom])
  @@index([academicClassId, academicTermId, status])
  @@index([programId, academicTermId])
  @@index([departmentId, academicTermId])
  @@map("student_enrollments")
}

model TeachingAssignment {
  id               String           @id @default(uuid()) @db.Uuid
  facultyId        String           @map("faculty_id") @db.Uuid
  academicTermId   String           @map("academic_term_id") @db.Uuid
  academicClassId  String           @map("academic_class_id") @db.Uuid
  programSubjectId String           @map("program_subject_id") @db.Uuid
  effectiveFrom    DateTime         @map("effective_from") @db.Date
  effectiveTo      DateTime?        @map("effective_to") @db.Date
  status           AssignmentStatus @default(ACTIVE)
  assignedBy       String?          @map("assigned_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  academicTerm       AcademicTerm        @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  academicClass      AcademicClass       @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  programSubject     ProgramSubject      @relation(fields: [programSubjectId], references: [id], onDelete: Restrict)
  timetableSlots     TimetableSlot[]
  attendanceSessions AttendanceSession[]

  @@unique([facultyId, academicTermId, academicClassId, programSubjectId, effectiveFrom])
  @@index([academicClassId, academicTermId, status])
  @@index([facultyId, academicTermId, status])
  @@map("teaching_assignments")
}

model ClassAdvisory {
  id              String           @id @default(uuid()) @db.Uuid
  facultyId       String           @map("faculty_id") @db.Uuid
  academicClassId String           @map("academic_class_id") @db.Uuid
  effectiveFrom   DateTime         @map("effective_from") @db.Date
  effectiveTo     DateTime?        @map("effective_to") @db.Date
  status          AssignmentStatus @default(ACTIVE)
  assignedBy      String?          @map("assigned_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  faculty       Faculty       @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  academicClass AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)

  @@unique([academicClassId, effectiveFrom])
  @@index([facultyId, status])
  @@map("class_advisories")
}

model DepartmentLeadershipAssignment {
  id            String           @id @default(uuid()) @db.Uuid
  departmentId  String           @map("department_id") @db.Uuid
  facultyId     String           @map("faculty_id") @db.Uuid
  role          LeadershipRole
  effectiveFrom DateTime         @map("effective_from") @db.Date
  effectiveTo   DateTime?        @map("effective_to") @db.Date
  status        AssignmentStatus @default(ACTIVE)
  assignedBy    String?          @map("assigned_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  faculty    Faculty    @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([departmentId, role, effectiveFrom])
  @@index([facultyId, status])
  @@map("department_leadership_assignments")
}

// ==================================================
// ACADEMIC OPERATIONS: TIMETABLE
// ==================================================

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model TimetableVersion {
  id              String       @id @default(uuid()) @db.Uuid
  academicTermId  String       @map("academic_term_id") @db.Uuid
  academicClassId String       @map("academic_class_id") @db.Uuid
  versionName     String       @map("version_name")
  status          RecordStatus @default(ACTIVE)
  effectiveFrom   DateTime     @map("effective_from") @db.Date
  effectiveTo     DateTime?    @map("effective_to") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicTerm  AcademicTerm    @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  academicClass AcademicClass   @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  slots         TimetableSlot[]

  @@index([academicClassId, academicTermId, status])
  @@map("timetable_versions")
}

model TimetableSlot {
  id                   String    @id @default(uuid()) @db.Uuid
  timetableVersionId   String    @map("timetable_version_id") @db.Uuid
  dayOfWeek            DayOfWeek @map("day_of_week")
  periodId             String    @map("period_id") @db.Uuid
  teachingAssignmentId String    @map("teaching_assignment_id") @db.Uuid
  roomId               String?   @map("room_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  timetableVersion   TimetableVersion   @relation(fields: [timetableVersionId], references: [id], onDelete: Restrict)
  period             PeriodDefinition   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  room               Room?              @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@unique([timetableVersionId, dayOfWeek, periodId])
  @@map("timetable_slots")
}

// ==================================================
// ATTENDANCE
// ==================================================

enum AttendanceSessionStatus {
  OPEN
  MARKED
  SAVED
  SUBMITTED
  LOCKED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_DUTY
  LATE
}

model AttendanceSession {
  id                   String                  @id @default(uuid()) @db.Uuid
  academicTermId       String                  @map("academic_term_id") @db.Uuid
  academicClassId      String                  @map("academic_class_id") @db.Uuid
  programSubjectId     String                  @map("program_subject_id") @db.Uuid
  teachingAssignmentId String                  @map("teaching_assignment_id") @db.Uuid
  date                 DateTime                @db.Date
  periodId             String                  @map("period_id") @db.Uuid
  status               AttendanceSessionStatus @default(OPEN)
  markedById           String?                 @map("marked_by_id") @db.Uuid
  submittedById        String?                 @map("submitted_by_id") @db.Uuid
  lockedById           String?                 @map("locked_by_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicTerm       AcademicTerm       @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  academicClass      AcademicClass      @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  programSubject     ProgramSubject     @relation(fields: [programSubjectId], references: [id], onDelete: Restrict)
  teachingAssignment TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Restrict)
  period             PeriodDefinition   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  markedBy           User?              @relation("SessionMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)
  submittedBy        User?              @relation("SessionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  lockedBy           User?              @relation("SessionLockedBy", fields: [lockedById], references: [id], onDelete: Restrict)
  entries            AttendanceEntry[]

  @@unique([academicTermId, academicClassId, programSubjectId, date, periodId], name: "canonical_session")
  @@index([academicClassId, date])
  @@map("attendance_sessions")
}

model AttendanceEntry {
  id                  String           @id @default(uuid()) @db.Uuid
  attendanceSessionId String           @map("attendance_session_id") @db.Uuid
  studentEnrollmentId String           @map("student_enrollment_id") @db.Uuid
  status              AttendanceStatus
  remarks             String?
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  attendanceSession AttendanceSession      @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  studentEnrollment StudentEnrollment      @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  corrections       AttendanceCorrection[]

  @@unique([attendanceSessionId, studentEnrollmentId])
  @@map("attendance_entries")
}

model AttendanceCorrection {
  id                String           @id @default(uuid()) @db.Uuid
  attendanceEntryId String           @map("attendance_entry_id") @db.Uuid
  previousStatus    AttendanceStatus @map("previous_status")
  newStatus         AttendanceStatus @map("new_status")
  reason            String
  correctedById     String           @map("corrected_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  attendanceEntry AttendanceEntry @relation(fields: [attendanceEntryId], references: [id], onDelete: Restrict)
  correctedBy     User            @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)

  @@map("attendance_corrections")
}

// ==================================================
// EXAMINATIONS + RESULTS
// ==================================================

enum AssessmentType {
  CIA_I
  CIA_II
  SEMESTER_END
  PRACTICAL
  PROJECT
}

enum AssessmentStatus {
  SCHEDULED
  CONDUCTED
  EVALUATED
  PUBLISHED
}

enum ResultStatus {
  ENTRY
  VALIDATION
  SUBMITTED
  APPROVED
  PUBLISHED
}

model Assessment {
  id               String           @id @default(uuid()) @db.Uuid
  academicTermId   String           @map("academic_term_id") @db.Uuid
  academicClassId  String           @map("academic_class_id") @db.Uuid
  programSubjectId String           @map("program_subject_id") @db.Uuid
  title            String
  type             AssessmentType
  date             DateTime?        @db.Date
  status           AssessmentStatus @default(SCHEDULED)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicTerm   AcademicTerm          @relation(fields: [academicTermId], references: [id], onDelete: Restrict)
  academicClass  AcademicClass         @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  programSubject ProgramSubject        @relation(fields: [programSubjectId], references: [id], onDelete: Restrict)
  components     AssessmentComponent[]
  resultEntries  ResultEntry[]
  publications   ResultPublication[]

  @@unique([academicTermId, academicClassId, programSubjectId, type])
  @@map("assessments")
}

model AssessmentComponent {
  id           String   @id @default(uuid()) @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  name         String
  maxMarks     Decimal  @map("max_marks") @db.Decimal(5, 2)
  weight       Decimal? @db.Decimal(5, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@map("assessment_components")
}

model ResultEntry {
  id                  String       @id @default(uuid()) @db.Uuid
  assessmentId        String       @map("assessment_id") @db.Uuid
  studentEnrollmentId String       @map("student_enrollment_id") @db.Uuid
  marksObtained       Decimal?     @map("marks_obtained") @db.Decimal(5, 2)
  isAbsent            Boolean      @default(false) @map("is_absent")
  status              ResultStatus @default(ENTRY)
  enteredById         String?      @map("entered_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  assessment        Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  enteredBy         User?             @relation("ResultEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)
  revisions         ResultRevision[]

  @@unique([assessmentId, studentEnrollmentId])
  @@map("result_entries")
}

model ResultRevision {
  id            String   @id @default(uuid()) @db.Uuid
  resultEntryId String   @map("result_entry_id") @db.Uuid
  previousMarks Decimal? @map("previous_marks") @db.Decimal(5, 2)
  newMarks      Decimal? @map("new_marks") @db.Decimal(5, 2)
  reason        String
  revisedById   String   @map("revised_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resultEntry ResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Restrict)
  revisedBy   User        @relation("ResultRevisedBy", fields: [revisedById], references: [id], onDelete: Restrict)

  @@map("result_revisions")
}

model ResultPublication {
  id            String   @id @default(uuid()) @db.Uuid
  assessmentId  String   @map("assessment_id") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedById String   @map("published_by_id") @db.Uuid

  assessment  Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  publishedBy User       @relation("ResultPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  @@map("result_publications")
}

// ==================================================
// FINANCE
// ==================================================

enum ChargeType {
  FEE
  ATTENDANCE_FINE
  LIBRARY_FINE
  LIBRARY_LOSS
  LIBRARY_DAMAGE
  CERTIFICATE_FEE
  EVENT_FEE
  LATE_FEE
}

enum FinancialStatus {
  DRAFT
  POSTED
  SETTLED
  PARTIALLY_SETTLED
  WAIVED
  VOIDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  GATEWAY
  BANK_TRANSFER
}

model FeeStructure {
  id             String       @id @default(uuid()) @db.Uuid
  code           String
  academicYearId String       @map("academic_year_id") @db.Uuid
  programId      String?      @map("program_id") @db.Uuid
  shiftId        String?      @map("shift_id") @db.Uuid
  category       String?
  version        Int          @default(1)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  academicYear AcademicYear            @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  program      Program?                @relation(fields: [programId], references: [id], onDelete: Restrict)
  shift        Shift?                  @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  components   FeeStructureComponent[]
  installments FeeInstallmentRule[]

  @@unique([code, version])
  @@map("fee_structures")
}

model FeeStructureComponent {
  id             String   @id @default(uuid()) @db.Uuid
  feeStructureId String   @map("fee_structure_id") @db.Uuid
  name           String
  amount         Decimal  @db.Decimal(10, 2)
  isMandatory    Boolean  @default(true) @map("is_mandatory")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@map("fee_structure_components")
}

model FeeInstallmentRule {
  id                String    @id @default(uuid()) @db.Uuid
  feeStructureId    String    @map("fee_structure_id") @db.Uuid
  installmentNumber Int       @map("installment_number")
  percentage        Decimal   @db.Decimal(5, 2)
  dueDate           DateTime? @map("due_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)

  @@map("fee_installment_rules")
}

model FinancialAccount {
  id                  String       @id @default(uuid()) @db.Uuid
  studentEnrollmentId String       @unique @map("student_enrollment_id") @db.Uuid
  status              RecordStatus @default(ACTIVE)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  studentEnrollment StudentEnrollment       @relation(fields: [studentEnrollmentId], references: [id], onDelete: Restrict)
  charges           FinancialCharge[]
  scholarships      ScholarshipConcession[]
  adjustments       FinancialAdjustment[]
  paymentIntents    PaymentIntent[]

  @@map("financial_accounts")
}

model FinancialCharge {
  id                 String          @id @default(uuid()) @db.Uuid
  financialAccountId String          @map("financial_account_id") @db.Uuid
  chargeType         ChargeType      @map("charge_type")
  amount             Decimal         @db.Decimal(10, 2)
  dueDate            DateTime?       @map("due_date") @db.Date
  sourceId           String?         @map("source_id")
  status             FinancialStatus @default(DRAFT)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  financialAccount FinancialAccount    @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  allocations      PaymentAllocation[]

  @@index([financialAccountId, status, dueDate])
  @@map("financial_charges")
}

model ScholarshipConcession {
  id                 String       @id @default(uuid()) @db.Uuid
  financialAccountId String       @map("financial_account_id") @db.Uuid
  amount             Decimal      @db.Decimal(10, 2)
  reason             String
  approvedById       String?      @map("approved_by_id") @db.Uuid
  status             RecordStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  approvedBy       User?            @relation("ScholarshipApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@map("scholarship_concessions")
}

model FinancialAdjustment {
  id                 String   @id @default(uuid()) @db.Uuid
  financialAccountId String   @map("financial_account_id") @db.Uuid
  amount             Decimal  @db.Decimal(10, 2)
  reason             String
  adjustedById       String   @map("adjusted_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  adjustedBy       User             @relation("AdjustmentAdjustedBy", fields: [adjustedById], references: [id], onDelete: Restrict)

  @@map("financial_adjustments")
}

model PaymentIntent {
  id                 String        @id @default(uuid()) @db.Uuid
  financialAccountId String        @map("financial_account_id") @db.Uuid
  amount             Decimal       @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  method             PaymentMethod
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  attempts         PaymentAttempt[]
  payments         Payment[]

  @@map("payment_intents")
}

model PaymentAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  paymentIntentId   String        @map("payment_intent_id") @db.Uuid
  providerReference String?       @map("provider_reference")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@map("payment_attempts")
}

model GatewayWebhookEvent {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String
  eventId    String   @unique @map("event_id")
  payload    Json     @db.JsonB
  status     String
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("gateway_webhook_events")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentIntentId String        @map("payment_intent_id") @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(SUCCESS)
  paymentDate     DateTime      @default(now()) @map("payment_date") @db.Timestamptz(6)
  receiptNumber   String?       @unique @map("receipt_number")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  paymentIntent PaymentIntent       @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  allocations   PaymentAllocation[]
  receipt       Receipt?

  @@map("payments")
}

model PaymentAllocation {
  id                String   @id @default(uuid()) @db.Uuid
  paymentId         String   @map("payment_id") @db.Uuid
  financialChargeId String   @map("financial_charge_id") @db.Uuid
  allocatedAmount   Decimal  @map("allocated_amount") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment         Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  financialCharge FinancialCharge @relation(fields: [financialChargeId], references: [id], onDelete: Restrict)

  @@map("payment_allocations")
}

model Receipt {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @unique @map("payment_id") @db.Uuid
  receiptNumber String   @unique @map("receipt_number")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById    String?  @map("issued_by_id") @db.Uuid

  payment  Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  issuedBy User?   @relation("ReceiptIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  @@map("receipts")
}

// --- ENUMS FOR PROMPT 4 ---
enum BookCopyStatus {
  AVAILABLE
  LOANED
  LOST
  DAMAGED
  MAINTENANCE
}

enum LoanStatus {
  ACTIVE
  RETURNED
  LOST
  DAMAGED
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum LibraryResolutionType {
  PAID
  REPLACED
}

enum PlacementRegistrationStatus {
  NOT_REGISTERED
  REGISTERED
  WITHDRAWN
}

enum DriveMode {
  ON_CAMPUS
  OFF_CAMPUS
  ONLINE
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  APTITUDE
  TECHNICAL_INTERVIEW
  HR_INTERVIEW
  SELECTED
  REJECTED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  JOINED
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum CertificateRequestStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  ISSUED
  REJECTED
  REVOKED
  SUPERSEDED
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  READ
  FAILED
}

// --- LIBRARY MODELS ---
model LibraryMember {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @unique @map("user_id") @db.Uuid
  user         User                 @relation(fields: [userId], references: [id])
  loans        LibraryLoan[]
  reservations LibraryReservation[]

  @@map("library_members")
}

model BookCatalog {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  isbn         String               @unique
  title        String
  author       String
  copies       BookCopy[]
  reservations LibraryReservation[]

  @@map("book_catalogs")
}

model BookCopy {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookCatalogId String         @map("book_catalog_id") @db.Uuid
  bookCatalog   BookCatalog    @relation(fields: [bookCatalogId], references: [id])
  copyNumber    String         @unique @map("copy_number")
  status        BookCopyStatus @default(AVAILABLE)
  loans         LibraryLoan[]

  @@map("book_copies")
}

model LibraryLoan {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryMemberId String              @map("library_member_id") @db.Uuid
  libraryMember   LibraryMember       @relation(fields: [libraryMemberId], references: [id])
  bookCopyId      String              @map("book_copy_id") @db.Uuid
  bookCopy        BookCopy            @relation(fields: [bookCopyId], references: [id])
  issueDate       DateTime            @default(now()) @map("issue_date")
  dueDate         DateTime            @map("due_date")
  returnDate      DateTime?           @map("return_date")
  status          LoanStatus          @default(ACTIVE)
  renewals        LoanRenewal[]
  resolutions     LibraryResolution[]

  @@map("library_loans")
}

model LoanRenewal {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryLoanId String      @map("library_loan_id") @db.Uuid
  libraryLoan   LibraryLoan @relation(fields: [libraryLoanId], references: [id])
  renewalDate   DateTime    @default(now()) @map("renewal_date")
  newDueDate    DateTime    @map("new_due_date")

  @@map("loan_renewals")
}

model LibraryResolution {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryLoanId  String                @unique @map("library_loan_id") @db.Uuid
  libraryLoan    LibraryLoan           @relation(fields: [libraryLoanId], references: [id])
  resolutionType LibraryResolutionType @map("resolution_type")
  resolvedAt     DateTime              @default(now()) @map("resolved_at")

  @@map("library_resolutions")
}

model LibraryReservation {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryMemberId String            @map("library_member_id") @db.Uuid
  libraryMember   LibraryMember     @relation(fields: [libraryMemberId], references: [id])
  bookCatalogId   String            @map("book_catalog_id") @db.Uuid
  bookCatalog     BookCatalog       @relation(fields: [bookCatalogId], references: [id])
  reservedAt      DateTime          @default(now()) @map("reserved_at")
  status          ReservationStatus @default(PENDING)

  @@map("library_reservations")
}

// --- PLACEMENT MODELS ---
model PlacementRegistration {
  id                  String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentEnrollmentId String                      @unique @map("student_enrollment_id") @db.Uuid
  studentEnrollment   StudentEnrollment           @relation(fields: [studentEnrollmentId], references: [id])
  status              PlacementRegistrationStatus @default(NOT_REGISTERED)
  profile             PlacementProfile?

  @@map("placement_registrations")
}

model PlacementProfile {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String                   @unique @map("registration_id") @db.Uuid
  registration   PlacementRegistration    @relation(fields: [registrationId], references: [id])
  resumeUrl      String?                  @map("resume_url")
  skills         PlacementSkill[]
  certifications PlacementCertification[]

  @@map("placement_profiles")
}

model PlacementSkill {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String           @map("profile_id") @db.Uuid
  profile   PlacementProfile @relation(fields: [profileId], references: [id])
  skillName String           @map("skill_name")

  @@map("placement_skills")
}

model PlacementCertification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String           @map("profile_id") @db.Uuid
  profile   PlacementProfile @relation(fields: [profileId], references: [id])
  name      String
  provider  String

  @@map("placement_certifications")
}

model Company {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String           @unique
  industry String?
  drives   PlacementDrive[]

  @@map("companies")
}

model PlacementDrive {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String                       @map("company_id") @db.Uuid
  company             Company                      @relation(fields: [companyId], references: [id])
  mode                DriveMode                    @default(ON_CAMPUS)
  scheduledDate       DateTime                     @map("scheduled_date")
  jobRoles            DriveJobRole[]
  courseEligibilities DriveCourseEligibility[]
  deptEligibilities   DriveDepartmentEligibility[]
  rounds              DriveRound[]
  applications        PlacementApplication[]

  @@map("placement_drives")
}

model DriveJobRole {
  id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId String         @map("drive_id") @db.Uuid
  drive   PlacementDrive @relation(fields: [driveId], references: [id])
  title   String
  ctc     Decimal?       @db.Decimal(10, 2)

  @@map("drive_job_roles")
}

model DriveCourseEligibility {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId   String         @map("drive_id") @db.Uuid
  drive     PlacementDrive @relation(fields: [driveId], references: [id])
  programId String         @map("program_id") @db.Uuid
  program   Program        @relation(fields: [programId], references: [id])

  @@map("drive_course_eligibilities")
}

model DriveDepartmentEligibility {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId      String         @map("drive_id") @db.Uuid
  drive        PlacementDrive @relation(fields: [driveId], references: [id])
  departmentId String         @map("department_id") @db.Uuid
  department   Department     @relation(fields: [departmentId], references: [id])

  @@map("drive_department_eligibilities")
}

model DriveRound {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId  String         @map("drive_id") @db.Uuid
  drive    PlacementDrive @relation(fields: [driveId], references: [id])
  name     String
  sequence Int

  @@map("drive_rounds")
}

model PlacementApplication {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  driveId             String                     @map("drive_id") @db.Uuid
  drive               PlacementDrive             @relation(fields: [driveId], references: [id])
  studentEnrollmentId String                     @map("student_enrollment_id") @db.Uuid
  studentEnrollment   StudentEnrollment          @relation(fields: [studentEnrollmentId], references: [id])
  status              ApplicationStatus          @default(APPLIED)
  statusHistory       ApplicationStatusHistory[]
  roundResults        RoundResult[]
  offer               PlacementOffer?

  @@map("placement_applications")
}

model ApplicationStatusHistory {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  application   PlacementApplication @relation(fields: [applicationId], references: [id])
  status        ApplicationStatus
  changedAt     DateTime             @default(now()) @map("changed_at")

  @@map("application_status_history")
}

model RoundResult {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String               @map("application_id") @db.Uuid
  application   PlacementApplication @relation(fields: [applicationId], references: [id])
  roundId       String               @map("round_id") @db.Uuid
  status        String

  @@map("round_results")
}

model PlacementOffer {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String               @unique @map("application_id") @db.Uuid
  application   PlacementApplication @relation(fields: [applicationId], references: [id])
  status        OfferStatus          @default(PENDING)
  ctc           Decimal              @db.Decimal(10, 2)

  @@map("placement_offers")
}

// --- EVENTS MODELS ---
model EventType {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name   String  @unique
  events Event[]

  @@map("event_types")
}

model Event {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventTypeId   String              @map("event_type_id") @db.Uuid
  eventType     EventType           @relation(fields: [eventTypeId], references: [id])
  title         String
  status        EventStatus         @default(DRAFT)
  isOnline      Boolean             @default(false) @map("is_online")
  capacity      Int?
  feeAmount     Decimal?            @map("fee_amount") @db.Decimal(10, 2)
  registrations EventRegistration[]
  attendances   EventAttendance[]

  @@map("events")
}

model EventRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  event        Event    @relation(fields: [eventId], references: [id])
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  registeredAt DateTime @default(now()) @map("registered_at")

  @@unique([eventId, userId])
  @@map("event_registrations")
}

model EventAttendance {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  event      Event    @relation(fields: [eventId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  attendedAt DateTime @default(now()) @map("attended_at")

  @@unique([eventId, userId])
  @@map("event_attendances")
}

// --- STORAGE MODEL ---
model StoredFile {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            String
  path                String
  mimeType            String               @map("mime_type")
  sizeBytes           Int                  @map("size_bytes")
  uploadedAt          DateTime             @default(now()) @map("uploaded_at")
  certificateDocument CertificateDocument?

  @@map("stored_files")
}

// --- CERTIFICATES MODELS ---
model CertificateType {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String               @unique
  requiresFee Boolean              @default(false) @map("requires_fee")
  feeAmount   Decimal?             @map("fee_amount") @db.Decimal(10, 2)
  requests    CertificateRequest[]

  @@map("certificate_types")
}

model CertificateRequest {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  certificateTypeId   String                   @map("certificate_type_id") @db.Uuid
  certificateType     CertificateType          @relation(fields: [certificateTypeId], references: [id])
  studentEnrollmentId String                   @map("student_enrollment_id") @db.Uuid
  studentEnrollment   StudentEnrollment        @relation(fields: [studentEnrollmentId], references: [id])
  status              CertificateRequestStatus @default(REQUESTED)
  history             CertificateHistory[]
  document            CertificateDocument?

  @@map("certificate_requests")
}

model CertificateHistory {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String                   @map("request_id") @db.Uuid
  request   CertificateRequest       @relation(fields: [requestId], references: [id])
  status    CertificateRequestStatus
  changedAt DateTime                 @default(now()) @map("changed_at")

  @@map("certificate_history")
}

model CertificateDocument {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId    String             @unique @map("request_id") @db.Uuid
  request      CertificateRequest @relation(fields: [requestId], references: [id])
  storedFileId String             @unique @map("stored_file_id") @db.Uuid
  storedFile   StoredFile         @relation(fields: [storedFileId], references: [id])

  @@map("certificate_documents")
}

// --- NOTIFICATIONS MODELS ---
model Notification {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  body       String
  status     NotificationStatus     @default(DRAFT)
  deliveries NotificationDelivery[]

  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  notification   Notification               @relation(fields: [notificationId], references: [id])
  userId         String                     @map("user_id") @db.Uuid
  user           User                       @relation(fields: [userId], references: [id])
  status         NotificationDeliveryStatus @default(PENDING)

  @@map("notification_deliveries")
}

model ProfileUpdateRequest {
  id        String                     @id @default(uuid()) @db.Uuid
  userId    String                     @map("user_id") @db.Uuid
  field     String
  oldValue  String?                    @map("old_value")
  newValue  String                     @map("new_value")
  status    ProfileUpdateRequestStatus @default(PENDING)
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("profile_update_requests")
}
